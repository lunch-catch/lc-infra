#!/bin/bash
${common_bootstrap}

# 메모리 2 GB 에 컨테이너 넷이 올라간다. 상한을 다 걸어도 순간적으로 넘치면 커널이 죽이므로 스왑을 둔다
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

install -d -m 0755 /opt/${project}-dev

cat > /opt/${project}-dev/compose.yaml <<'COMPOSE'
${compose}
COMPOSE

cat > /opt/${project}-dev/Caddyfile <<'CADDY'
${caddyfile}
CADDY

cat > /usr/local/bin/${project}-dev-refresh <<'REFRESH'
${refresh}
REFRESH
chmod 755 /usr/local/bin/${project}-dev-refresh

# 컨테이너는 restart: unless-stopped 라 서버를 중지했다 켜면 Docker 가 다시 올린다. 이것은 최초 한 번이다
/usr/local/bin/${project}-dev-refresh
