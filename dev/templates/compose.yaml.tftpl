# 개발 서버의 전부다 (개발 서버 문서 4장).
# t3.small 의 2 GB 에 넷을 올리므로 모두 메모리 상한을 둔다. 상한이 없으면 JVM 이 호스트 기준으로
# 힙을 잡아 MySQL 과 다투다 커널 OOM 으로 죽는다.
# 값은 .env 에서 온다. lunchcatch-dev-refresh 가 SSM 을 읽어 통째로 다시 쓴다.
services:
  caddy:
    image: caddy:2.10
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    mem_limit: 64m

  app:
    # 배포 기록이 없으면 none 이 된다. 그때는 refresh 가 app 을 올리지 않는다.
    image: ${image}:$${GIT_SHA:-none}
    container_name: ${project}
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
      valkey:
        condition: service_started
    environment:
      # 서버가 하나라 API 와 스케줄러를 한 프로세스에서 돌린다. batch 가 스케줄러를 켜고 풀을 5 로 둔다
      # prod 는 로그 출력(JSON)만 켠다. 빠지면 logback 에 출력이 없어 docker logs 가 빈다
      SPRING_PROFILES_ACTIVE: "prod,batch"
      DB_URL: "jdbc:mysql://mysql:3306/${project}"
      DB_USERNAME: "${project}"
      DB_PASSWORD: "$${DB_PASSWORD}"
      # 개발 전용 키다. 개발에서 찍은 토큰이 운영에서 통과하면 안 된다
      JWT_SECRET: "$${JWT_SECRET}"
      JWT_COOKIE_SECURE: "true"
      KAKAO_CLIENT_ID: "$${KAKAO_CLIENT_ID}"
      KAKAO_CLIENT_SECRET: "$${KAKAO_CLIENT_SECRET}"
      KAKAO_APP_ID: "$${KAKAO_APP_ID}"
      KAKAO_ADMIN_KEY: "$${KAKAO_ADMIN_KEY}"
      # 토스 테스트 비밀키다. 없으면 앱이 키 자리표시자 글자 그대로 인증해 토스가 500 을 준다
      TOSS_SECRET_KEY: "$${TOSS_SECRET_KEY}"
      VALKEY_HOST: "valkey"
      VALKEY_PORT: "6379"
      # 개발 프론트 셋이다. 같은 사이트라 Strict 쿠키가 실린다 (프론트엔드 배포 문서 2.1절)
      CORS_ALLOWED_ORIGINS: "${frontend_origins}"
      # 개발 사용자 앱의 콜백이다. 카카오 개발자 콘솔의 Redirect URI 에도 있어야 한다
      KAKAO_REDIRECT_URI: "https://${kakao_callback_host}/oauth/callback"
      # 개발 이미지 저장소다. 버킷과 CDN 은 bootstrap/dev_media.tf 가 갖는다
      CDN_BASE_URL: "${cdn_base_url}"
      S3_MEDIA_BUCKET: "${media_bucket}"
      S3_REGION: "${region}"
      # 기본 세계(lc-backend db/base) 스위치와 기준일이다. 예전 시험 시드(db/seed)를 대신한다 (lc-infra #29)
      BASE_ENABLED: "$${BASE_ENABLED}"
      BASE_DATE: "$${BASE_DATE}"
      # 기본 계정 비밀번호의 BCrypt 해시다. .env 에서 작은따옴표로 감싸 $ 가 변수로 읽히지 않는다
      ACCOUNT_SUPERADMIN_PASSWORD_HASH: "$${ACCOUNT_SUPERADMIN_PASSWORD_HASH}"
      ACCOUNT_DEMO_ADMIN_PASSWORD_HASH: "$${ACCOUNT_DEMO_ADMIN_PASSWORD_HASH}"
      ACCOUNT_DEMO_OWNER_PASSWORD_HASH: "$${ACCOUNT_DEMO_OWNER_PASSWORD_HASH}"
      ACCOUNT_SCENARIO_PASSWORD_HASH: "$${ACCOUNT_SCENARIO_PASSWORD_HASH}"
      # 관리자 템플릿 생성의 LLM 이다. 서버 역할로 인증한다 (LLM 문서 4.2절)
      BEDROCK_MODEL_ID: "${bedrock_model_id}"
      BEDROCK_REGION: "${bedrock_region}"
      APP_NAME: "${project}-dev"
      APP_INSTANCE_ID: "dev"
      TRACE_SAMPLE_RATE: "0"
      # 힙은 컨테이너 상한(mem_limit)의 70% 다. 상한이 있어야 이 비율이 뜻대로 돈다
      # user.timezone 이 빠지면 DB 시각이 9시간 밀려 저장된다. Hibernate 가 JVM 시간대(UTC)로 넘기고 드라이버가 세션 시간대(Asia/Seoul)로 다시 바꾼다.
      JAVA_TOOL_OPTIONS: >-
        -XX:MaxRAMPercentage=70
        -Dnetworkaddress.cache.ttl=5
        -Dnetworkaddress.cache.negative.ttl=1
        -Duser.timezone=Asia/Seoul
    mem_limit: 1100m
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health/liveness"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 90s
    stop_grace_period: 45s
    # CloudWatch Logs 로도 보낸다. 팀원이 서버에 들어오지 않고 scripts/dev-logs.sh 로 본다 (개발 서버 문서 10장).
    # 컨테이너를 다시 만들어도 30일 남는다. docker logs 도 그대로 된다(Docker 의 이중 로깅).
    # non-blocking 이라 CloudWatch 가 느려도 앱이 멈추지 않는다
    logging:
      driver: awslogs
      options:
        awslogs-region: "${region}"
        awslogs-group: "${log_group}"
        mode: non-blocking
        max-buffer-size: 4m

  mysql:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "${project}"
      MYSQL_USER: "${project}"
      MYSQL_PASSWORD: "$${DB_PASSWORD}"
      MYSQL_ROOT_PASSWORD: "$${DB_PASSWORD}"
    # 버퍼 풀을 줄이고 성능 스키마를 꺼 메모리를 아낀다. 개발 데이터는 작다
    command:
      - --innodb-buffer-pool-size=128M
      - --performance-schema=OFF
      - --max-connections=50
    # 서버 안쪽 주소에만 연다. 팀원은 SSM 포트 포워딩으로 들어온다 (개발 서버 문서 10장). 인터넷에는 열리지 않는다
    ports:
      - "127.0.0.1:3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql
    mem_limit: 512m
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "--silent"]
      interval: 5s
      timeout: 3s
      retries: 30

  valkey:
    image: valkey/valkey:9.0-alpine
    restart: unless-stopped
    # 리프레시 토큰이 여기 있다. 꽉 차도 지우지 않고 쓰기를 거절한다. 지우면 로그인이 풀린다
    command:
      - valkey-server
      - --maxmemory
      - 64mb
      - --maxmemory-policy
      - noeviction
      - --appendonly
      - "yes"
    volumes:
      - valkey-data:/data
    mem_limit: 128m

  # 앱 지표를 긁는다 (개발 서버 문서 11장). 설정은 refresh 가 받아 두는 lc-infra 사본(./infra)에서 읽는다
  prometheus:
    image: prom/prometheus:v3.13.1
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d
    volumes:
      - ./infra/dev/observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    mem_limit: 384m

  # https://${grafana_host} 로 연다. 밖에서는 Caddy 를 거쳐서만 닿는다
  # 127.0.0.1 에도 여는 것은 refresh 가 팀 계정을 맞출 때 서버 안에서 API 를 부르려는 것이다
  grafana:
    image: grafana/grafana:12.4.3
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      GF_SERVER_ROOT_URL: "https://${grafana_host}"
      GF_SECURITY_ADMIN_USER: "admin"
      GF_SECURITY_ADMIN_PASSWORD: "$${GRAFANA_ADMIN_PASSWORD}"
      # 인터넷에 열려 있어 가입과 익명 접근을 막는다. 계정은 refresh 가 만든다
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      # CloudWatch 데이터 소스가 서버 역할로 인증한다
      AWS_REGION: "${region}"
    volumes:
      - ./infra/dev/observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./infra/observability/grafana/dashboards:/etc/grafana/dashboards/common:ro
      - ./infra/dev/observability/grafana/dashboards:/etc/grafana/dashboards/dev:ro
      - grafana-data:/var/lib/grafana
    depends_on:
      - prometheus
    mem_limit: 256m

volumes:
  caddy-data:
  caddy-config:
  mysql-data:
  valkey-data:
  prometheus-data:
  grafana-data:
