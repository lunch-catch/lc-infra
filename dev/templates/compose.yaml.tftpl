# 개발 서버의 전부다 (개발 서버 문서 4장).
# t3.small 의 2 GB 에 넷을 올리므로 모두 메모리 상한을 둔다. 상한이 없으면 JVM 이 호스트 기준으로
# 힙을 잡아 MySQL 과 다투다 커널 OOM 으로 죽는다.
# 값은 .env 에서 온다. lunchcatch-dev-refresh 가 SSM 을 읽어 통째로 다시 쓴다.
services:
  caddy:
    image: caddy:2.10
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    mem_limit: 64m

  app:
    # 배포 기록이 없으면 none 이 된다. 그때는 refresh 가 app 을 올리지 않는다.
    image: ${image}:$${GIT_SHA:-none}
    container_name: ${project}
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
      valkey:
        condition: service_started
    environment:
      # 서버가 하나라 API 와 스케줄러를 한 프로세스에서 돌린다. batch 가 스케줄러를 켜고 풀을 5 로 둔다
      SPRING_PROFILES_ACTIVE: "batch"
      DB_URL: "jdbc:mysql://mysql:3306/${project}"
      DB_USERNAME: "${project}"
      DB_PASSWORD: "$${DB_PASSWORD}"
      # 개발 전용 키다. 개발에서 찍은 토큰이 운영에서 통과하면 안 된다
      JWT_SECRET: "$${JWT_SECRET}"
      JWT_COOKIE_SECURE: "true"
      KAKAO_CLIENT_ID: "$${KAKAO_CLIENT_ID}"
      KAKAO_CLIENT_SECRET: "$${KAKAO_CLIENT_SECRET}"
      KAKAO_APP_ID: "$${KAKAO_APP_ID}"
      KAKAO_ADMIN_KEY: "$${KAKAO_ADMIN_KEY}"
      VALKEY_HOST: "valkey"
      VALKEY_PORT: "6379"
      # 개발 프론트 셋이다. 같은 사이트라 Strict 쿠키가 실린다 (프론트엔드 배포 문서 2.1절)
      CORS_ALLOWED_ORIGINS: "${frontend_origins}"
      # 개발 사용자 앱의 콜백이다. 카카오 개발자 콘솔의 Redirect URI 에도 있어야 한다
      KAKAO_REDIRECT_URI: "https://${kakao_callback_host}/oauth/callback"
      # 개발 서버에는 이미지 저장소가 없다. 이미지 업로드는 동작하지 않는다
      CDN_BASE_URL: ""
      APP_NAME: "${project}-dev"
      APP_INSTANCE_ID: "dev"
      TRACE_SAMPLE_RATE: "0"
      # 힙은 컨테이너 상한(mem_limit)의 70% 다. 상한이 있어야 이 비율이 뜻대로 돈다
      JAVA_TOOL_OPTIONS: >-
        -XX:MaxRAMPercentage=70
        -Dnetworkaddress.cache.ttl=5
        -Dnetworkaddress.cache.negative.ttl=1
    mem_limit: 1100m
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health/liveness"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 90s
    stop_grace_period: 45s
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  mysql:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "${project}"
      MYSQL_USER: "${project}"
      MYSQL_PASSWORD: "$${DB_PASSWORD}"
      MYSQL_ROOT_PASSWORD: "$${DB_PASSWORD}"
    # 버퍼 풀을 줄이고 성능 스키마를 꺼 메모리를 아낀다. 개발 데이터는 작다
    command:
      - --innodb-buffer-pool-size=128M
      - --performance-schema=OFF
      - --max-connections=50
    volumes:
      - mysql-data:/var/lib/mysql
    mem_limit: 512m
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "--silent"]
      interval: 5s
      timeout: 3s
      retries: 30

  valkey:
    image: valkey/valkey:9.0-alpine
    restart: unless-stopped
    # 리프레시 토큰이 여기 있다. 꽉 차도 지우지 않고 쓰기를 거절한다. 지우면 로그인이 풀린다
    command:
      - valkey-server
      - --maxmemory
      - 64mb
      - --maxmemory-policy
      - noeviction
      - --appendonly
      - "yes"
    volumes:
      - valkey-data:/data
    mem_limit: 128m

volumes:
  caddy-data:
  caddy-config:
  mysql-data:
  valkey-data:
