#!/bin/bash
${common_bootstrap}

# 관측 설정은 Git 이 유일한 출처다 (INF-32).
# 임계값은 부하 시험 후 여러 번 고칠 값이라 Terraform 에 넣지 않는다.
# 고친 뒤에는 이 인스턴스에서 git pull 하고 reload 한다 (OPS-2-18).
GITHUB_TOKEN=$(aws ssm get-parameter --name "/${project}/github-token" --region ${region} --with-decryption --query 'Parameter.Value' --output text)
install -d -m 0755 /opt/${project}
# 저장소가 PUBLIC 이라 토큰이 없어도 받는다. 팀원 부하 시험 환경은 none 을 넣는다 (#11)
if [ "$GITHUB_TOKEN" = "none" ]; then
  git clone --depth 1 "https://github.com/${github_org}/${infra_repo}.git" /opt/${project}/infra
else
  git clone --depth 1 "https://x-access-token:$GITHUB_TOKEN@github.com/${github_org}/${infra_repo}.git" /opt/${project}/infra
fi

#
# 관측 이미지를 먼저 받는다 (#78).
#
# 이 인스턴스는 RDS 와 캐시를 기다리지 않고 뜬다. 이미지 14개를 받는 12분을 RDS 가 만들어지는 13분과 겹치려는 것이다.
# 받는 데는 DB 주소가 필요 없다. 주소는 아래 refresh-monitoring-env 가 컨테이너를 띄우기 직전에 기다려 읽는다.
#
# .env 가 아직 없어 빈 파일을 둔다. caddy 의 env_file 이 파일을 요구해 없으면 compose 가 아무것도 하지 않는다.
# 프로필은 모두 켠다. 어느 프로필을 쓸지는 .env 가 정하는데 아직 모른다. 안 쓰는 이미지는 caddy 하나뿐이고 작다.
# 받기에 실패해도 멈추지 않는다. compose up 이 빠진 이미지를 다시 받는다.
#
touch /opt/${project}/infra/observability/.env
(cd /opt/${project}/infra/observability && docker compose --profile '*' pull --quiet) \
  || echo "관측 이미지를 미리 받지 못했다. compose up 이 다시 받는다" >&2

# SSM 조회와 .env 생성을 스크립트로 빼 둔다.
# 엔드포인트가 바뀌면 다시 돌려야 하므로 여기 인라인으로 두지 않는다.
cat > /usr/local/bin/${project}-refresh-monitoring-env <<'REFRESH'
${refresh_env}
REFRESH
chmod 755 /usr/local/bin/${project}-refresh-monitoring-env

/usr/local/bin/${project}-refresh-monitoring-env

cat > /etc/systemd/system/observability.service <<'UNIT'
[Unit]
Description=observability stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/${project}/infra/observability
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now observability.service
