#!/bin/bash
#
# SSM 에서 값을 읽어 .env 를 통째로 다시 만든다.
#
# 최초 부팅과 재배포가 같은 코드를 쓴다.
# 부분 수정(GIT_SHA 만 sed)을 하면 나머지 값이 부팅 시점에 고정되어,
# RDS 복원으로 엔드포인트가 바뀌어도 배치가 따라가지 못한다 (INF-26).
set -euo pipefail

P=/${project}
R=${region}

# 파라미터가 아직 없으면 기다린다.
#
# 인스턴스가 그 값을 만드는 자원보다 먼저 뜰 수 있다. 2026-09-26 에 배치가 RDS 보다 16분
# 먼저 떠서 db-endpoint 가 없었고, set -e 가 여기서 스크립트를 끝냈다. systemd 유닛조차
# 안 쓰여서 인스턴스는 살아 있는데 아무것도 안 도는 상태가 됐다. 그 인스턴스는 ASG 밖이라
# 스스로 낫지도 않는다. 증상이 앱 장애처럼 보여 원인을 찾는 데 오래 걸린다.
#
# ParameterNotFound 만 기다린다. 값이 곧 생길 수 있는 유일한 경우다.
# AccessDenied 나 자격 문제는 기다려도 안 풀리므로 즉시 죽는다. 기다리면 진짜 이유가
# 상한까지 묻힌다.
SSM_WAIT=600
_read() {
  local flag=$1 name=$2 out deadline
  deadline=$(( $(date +%s) + SSM_WAIT ))
  while :; do
    if out=$(aws ssm get-parameter --name "$P/$name" --region "$R" $flag                --query 'Parameter.Value' --output text 2>&1); then
      printf '%s' "$out"
      return 0
    fi
    case "$out" in
      *ParameterNotFound*) : ;;
      *) echo "SSM $name 읽기 실패: $out" >&2; return 1 ;;
    esac
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "SSM $name 이 $SSM_WAIT 초 안에 생기지 않았다" >&2
      return 1
    fi
    echo "SSM $name 대기" >&2
    sleep 10
  done
}
get() { _read "" "$1"; }
sec() { _read --with-decryption "$1"; }

GIT_SHA=$(get current-sha)
DB_ENDPOINT=$(get db-endpoint)
CACHE_ENDPOINT=$(get cache-endpoint)
CDN_DOMAIN=$(get cdn-domain)
LOKI_ENDPOINT=$(get loki-endpoint)
# 배치만 쓴다. compose 가 role 이 batch 일 때만 컨테이너로 넘긴다.
BATCH_SCHEDULER_ENABLED=$(get batch-scheduler-enabled)
DB_PASSWORD=$(sec db-password)

# 앱이 기본값 없이 요구하는 값들이다. 하나라도 빠지면 @Value 가 기동을 막는다.
JWT_SECRET=$(sec jwt-signing-key)
KAKAO_CLIENT_ID=$(sec kakao-client-id)
KAKAO_CLIENT_SECRET=$(sec kakao-client-secret)
KAKAO_APP_ID=$(sec kakao-app-id)
KAKAO_ADMIN_KEY=$(sec kakao-admin-key)
# 토스페이먼츠 비밀키. 없으면 앱이 키 자리표시자 글자로 인증해 토스가 빈 500 을 준다 (2026-10-21)
TOSS_SECRET_KEY=$(sec toss-secret-key)

# 운영 모드다. scripts/apply.sh --mode 가 정하고 배포와 재부팅 때마다 여기서 다시 읽는다.
# loadtest 면 스프링 프로필에 loadtest 가 붙어 결제를 토스 대신 앱 안의 목이 받는다 (lc-backend #715).
# 값이 없거나 모르는 값이면 loadtest 로 뜬다. 실결제는 live 를 적어 둔 때만 돈다.
RUN_MODE=$(aws ssm get-parameter --name "$P/run-mode" --region "$R" --query 'Parameter.Value' --output text 2> /dev/null || echo loadtest)
case "$RUN_MODE" in
  live) PROFILE_SUFFIX="" ;;
  loadtest) PROFILE_SUFFIX=",loadtest" ;;
  *) echo "run-mode 값 $RUN_MODE 을 모른다. loadtest 로 뜬다" >&2; RUN_MODE=loadtest; PROFILE_SUFFIX=",loadtest" ;;
esac

# 기본 세계(lc-backend db/base) 스위치와 기준일, 기본 계정 비밀번호 해시다 (lc-infra #29).
# 없어도 기동을 막지 않는다. 스위치가 꺼져 있으면 앱이 해시를 쓰지 않는다. 켰는데 해시가 비면 앱이 뜨지 않는다.
opt() { aws ssm get-parameter --name "$P/$1" --region "$R" --query 'Parameter.Value' --output text 2> /dev/null || true; }
BASE_ENABLED=$(opt base-enabled)
[ "$BASE_ENABLED" = "true" ] || BASE_ENABLED=false
BASE_DATE=$(opt base-date)
ACCOUNT_SUPERADMIN_PASSWORD_HASH=$(opt account-superadmin-password-hash)
ACCOUNT_DEMO_ADMIN_PASSWORD_HASH=$(opt account-demo-admin-password-hash)
ACCOUNT_DEMO_OWNER_PASSWORD_HASH=$(opt account-demo-owner-password-hash)
ACCOUNT_SCENARIO_PASSWORD_HASH=$(opt account-scenario-password-hash)

TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

#
# ECR 로그인이다. 인스턴스 프로파일이 권한을 갖고 있어 호스트에 둘 자격증명이 없다.
#
# GHCR 일 때는 SSM 의 ghcr-token 을 받아 docker login 을 했다. 그 토큰은 만료와 회전을
# 사람이 관리해야 했고, 인스턴스가 그것을 평문으로 쥐고 있었다. 여기서는 둘 다 사라진다.
#
# 이 토큰은 12시간짜리라 재부팅이나 재배포마다 새로 받는다. 이 스크립트가 그때마다 돈다.
#
# 이미지가 GHCR 공개 패키지면(팀원 부하 시험 환경) 로그인 없이 받으므로 이 줄이 렌더링되지 않는다.
#
%{ if ecr_login ~}
aws ecr get-login-password --region "$R" \
  | docker login --username AWS --password-stdin ${registry}
%{ endif ~}

install -d -m 0755 /opt/${project}
cat > /opt/${project}/.env <<ENV
GIT_SHA=$GIT_SHA
LOKI_ENDPOINT=$LOKI_ENDPOINT
CACHE_ENDPOINT=$CACHE_ENDPOINT
CDN_DOMAIN=$CDN_DOMAIN
DB_ENDPOINT=$DB_ENDPOINT
DB_PASSWORD=$DB_PASSWORD
JWT_SECRET=$JWT_SECRET
KAKAO_CLIENT_ID=$KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=$KAKAO_CLIENT_SECRET
KAKAO_APP_ID=$KAKAO_APP_ID
KAKAO_ADMIN_KEY=$KAKAO_ADMIN_KEY
TOSS_SECRET_KEY=$TOSS_SECRET_KEY
APP_INSTANCE_ID=$INSTANCE_ID
BATCH_SCHEDULER_ENABLED=$BATCH_SCHEDULER_ENABLED
RUN_MODE=$RUN_MODE
PROFILE_SUFFIX=$PROFILE_SUFFIX
BASE_ENABLED=$BASE_ENABLED
BASE_DATE=$BASE_DATE
ACCOUNT_SUPERADMIN_PASSWORD_HASH='$ACCOUNT_SUPERADMIN_PASSWORD_HASH'
ACCOUNT_DEMO_ADMIN_PASSWORD_HASH='$ACCOUNT_DEMO_ADMIN_PASSWORD_HASH'
ACCOUNT_DEMO_OWNER_PASSWORD_HASH='$ACCOUNT_DEMO_OWNER_PASSWORD_HASH'
ACCOUNT_SCENARIO_PASSWORD_HASH='$ACCOUNT_SCENARIO_PASSWORD_HASH'
ENV
chmod 600 /opt/${project}/.env
