          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (use) (rate(adserving_cache_bypass_total[$__rate_interval]) * 60)",
          "legendFormat": "{{use}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "정산에서 예산을 못 읽은 횟수",
      "description": "광고 서빙이 정산에서 그날 예산(예약액과 단가)을 읽지 못한 횟수다. 00:00 후보 적재 끝과 10분마다 읽어 10분 창으로 센다. 못 읽으면 이전 값을 쓴다. 값이 처음부터 없으면 그동안 피드가 예산 규칙 없이 나간다. AdservingBudgetUnavailable.",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(adserving_budget_unavailable_total[10m]))",
          "legendFormat": "못 읽은 횟수",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "서빙 로그",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "id": 4,
      "panels": []
    },
    {
      "type": "timeseries",
