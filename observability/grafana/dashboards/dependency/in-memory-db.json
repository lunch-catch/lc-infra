{
  "uid": "lc-in-memory-db",
  "title": "2. 인메모리 DB",
  "description": "인메모리 DB(ElastiCache 의 Valkey)다. 캐시만이 아니라 노출 상한 카운터, 릴레이의 점유, 선착순 수량, 대기열에 쓴다. 익스포터(redis_exporter)와 앱(Lettuce)이 보는 것과 CloudWatch 가 보는 것이다",
  "tags": [
    "lunchcatch",
    "의존 시스템"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "배포와 재기동",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "step": "60s",
        "expr": "max by (job, instance, instance_id, version) (process_start_time_seconds{job=~\"app|batch\"}) * 1000",
        "titleFormat": "{{job}} 기동",
        "textFormat": "{{instance}} {{instance_id}} 버전 {{version}}",
        "useValueForTime": true
      }
    ]
  },
  "links": [
