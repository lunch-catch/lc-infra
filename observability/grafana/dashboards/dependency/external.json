{
  "uid": "lc-external",
  "title": "3. 외부 연동",
  "description": "외부 HTTP 호출(카카오, 토스)과 AWS SDK 호출(Bedrock, S3, Rekognition)의 요청률, 실패율, 처리 시간을 본다. 기준은 아직 정하지 않았다",
  "tags": [
    "lunchcatch",
    "의존 시스템"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "배포와 재기동",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "step": "60s",
        "expr": "label_replace(max by (job, instance, instance_id, version) (process_start_time_seconds{job=~\"app|batch\"}), \"version\", \"미수집\", \"version\", \"\") * 1000",
        "titleFormat": "{{job}} 기동",
        "textFormat": "{{instance}} {{instance_id}} 버전 {{version}}",
        "useValueForTime": true
      }
    ]
  },
  "links": [
    {
      "title": "1. 개요",
