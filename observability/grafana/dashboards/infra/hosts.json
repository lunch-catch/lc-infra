        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_applicationelb_httpcode_elb_5_xx_count_sum",
          "legendFormat": "5xx 전체",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aws_applicationelb_httpcode_elb_502_count_sum",
          "legendFormat": "502",
