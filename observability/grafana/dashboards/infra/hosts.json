  "panels": [
    {
      "type": "row",
      "title": "CPU 크레딧",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "EC2 CPU 크레딧 잔량",
      "description": "node_exporter 에는 이 값이 없다. 하이퍼바이저가 관리해 호스트 안에서 보이지 않는다. 인스턴스가 unlimited 모드라 이 선을 넘어도 느려지지 않는다. 새 인스턴스는 0 에서 시작해 시간당 24 씩 쌓인다. 선은 최대 누적량 576 의 30%(173) 와 10%(58) 로 부하 시험 전에 보는 참고선이다. 알람은 잔량이 아니라 초과분(CpuSurplusCreditInUse, CpuSurplusCreditCharged)을 본다.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 173
              },
              {
                "color": "red",
                "value": 58
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_ec2_cpucredit_balance_average",
          "legendFormat": "{{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "EC2 CPU 잉여 크레딧",
      "description": "크레딧이 바닥난 뒤 무제한 모드로 빌려 쓴 크레딧(잔량)과 그 가운데 돈으로 청구된 크레딧이다. 빌려 쓴 것이 1시간 넘게 0 보다 크면 경보 CpuSurplusCreditInUse 가, 청구가 생기면 경보 CpuSurplusCreditCharged 가 울린다. 0 이 정상이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_ec2_cpusurplus_credit_balance_average",
          "legendFormat": "빌려 쓴 크레딧 {{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aws_ec2_cpusurplus_credits_charged_sum",
          "legendFormat": "청구된 크레딧 {{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "id": 12
    },
    {
      "type": "row",
      "title": "호스트",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "기계 전체의 CPU 사용률이다. 모든 코어에서 쉬는(idle) 시간을 뺀 비율이고, 컨테이너마다의 CPU 는 아래 컨테이너 줄이 본다",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance, instance_id) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "{{instance}} {{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "메모리 사용률",
      "description": "기계 전체의 메모리 사용률이다. 커널이 내줄 수 있다고 본 메모리(MemAvailable)를 뺀 몫의 비율이고, 컨테이너마다의 메모리는 아래 컨테이너 줄이 본다",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}} {{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "디스크 사용률",
      "description": "DiskUsageHigh 임계 80% 를 선으로 그렸다. 읽기 전용 파일시스템은 경보 DiskUsageHigh 처럼 표시하지 않는다",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"} * 100)) and node_filesystem_readonly == 0",
          "legendFormat": "{{instance}} {{instance_id}} {{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "부하 평균 (1분)",
      "description": "1분 부하 평균이다. CPU 를 쓰거나 기다리는 태스크와, 디스크 I/O 처럼 끊을 수 없는 대기에 든 태스크 수의 평균이라 사용률이 아니다. 코어 수보다 오래 크면 일이 쌓이고 있다. CPU 때문인지 디스크 때문인지는 CPU 사용률과 디스크 지표를 함께 보고 가린다",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "{{instance}} {{instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 7
    },
    {
      "type": "row",
      "title": "컨테이너",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "컨테이너 CPU",
      "description": "그 기계의 컨테이너마다 쓰는 CPU 를 코어 수로 그린다. 기계 전체의 CPU 사용률이 높을 때 어느 컨테이너가 쓰는지 가른다. 운영의 앱 컨테이너에는 CPU 상한이 없어 제한(throttling)은 그리지 않는다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, instance_id, name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{instance_id}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "컨테이너 메모리",
      "description": "그 기계의 컨테이너마다 쓰는 메모리(working set)다. 파일 캐시 가운데 돌려줄 수 있는 몫을 뺀 값이다. 컨테이너 단위 값이라 그 컨테이너가 읽은 파일의 활성 캐시도 들어간다. 애플리케이션 서버 자원의 JVM 메모리(자바 힙, 힙 밖)와의 차이를 프로세스만의 메모리로 읽지 않는다",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name!=\"\"}",
          "legendFormat": "{{instance}} {{instance_id}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "컨테이너 재기동 (10분 내)",
      "description": "ContainerRestartLoop 임계 3회를 선으로 그렸다. OOM 이 가장 흔한 원인이다.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(container_start_time_seconds[10m])",
          "legendFormat": "{{instance}} {{instance_id}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 11
    }
  ]
}
