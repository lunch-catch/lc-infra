            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_operation) (rate(lettuce_seconds_sum[$__rate_interval])) / sum by (db_operation) (rate(lettuce_seconds_count[$__rate_interval]))",
          "legendFormat": "평균 {{db_operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
