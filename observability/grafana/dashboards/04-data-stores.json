    {
      "type": "timeseries",
      "title": "커넥션",
      "description": "앱 2대로 늘리기 전에 확인해야 하는 값이 max 다. 앱과 배치와 익스포터가 같이 쓴다.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "연결",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "쿼리 실행 중 스레드",
          "datasource": {
