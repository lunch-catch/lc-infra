    {
      "type": "timeseries",
      "title": "쿼리",
      "description": "MySQL 이 처리한 쿼리 수를 초당으로 본다. slow query 는 값의 크기가 달라 아래 패널에 따로 그린다.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_queries[$__rate_interval])",
          "legendFormat": "쿼리/초",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slow query (분당)",
      "description": "long_query_time(1초)을 넘긴 쿼리 수를 분당으로 본다. 0 이면 그 구간에 1초를 넘긴 쿼리가 없었다. 어떤 쿼리였는지는 이 패널로 알 수 없다. 쿼리 원문과 걸린 시간, 락 대기 시간(Lock_time)은 CloudWatch Logs 의 /aws/rds/instance/<project>-db/slowquery 에 있다.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_global_status_slow_queries[$__rate_interval])) * 60",
          "legendFormat": "slow query/분",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "InnoDB 행 락 대기",
      "description": "쿼리가 다른 트랜잭션이 잡은 행을 기다린 횟수(분당)와 한 번 기다린 평균 시간(오른쪽 축), 지금 기다리는 수다. 모두 0 이면 그 구간에 행 락 대기가 없었다. slow query 가 늘었는데 이 값이 0 이면 느린 까닭은 락이 아니라 쿼리 자체다.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "평균 대기 ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mysql_global_status_innodb_row_lock_waits[$__rate_interval])) * 60",
          "legendFormat": "대기/분",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(mysql_global_status_innodb_row_lock_time[$__rate_interval])) / sum(rate(mysql_global_status_innodb_row_lock_waits[$__rate_interval]))",
          "legendFormat": "평균 대기 ms",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(mysql_global_status_innodb_row_lock_current_waits)",
          "legendFormat": "지금 대기",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
