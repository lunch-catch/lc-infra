          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(adserving_serve_log_dropped_total[$__rate_interval])) or vector(0)) + (sum(rate(adserving_serve_log_failed_total[$__rate_interval])) or vector(0))) / (sum(rate(adserving_served_cards_total[$__rate_interval])) > 0)",
          "legendFormat": "유실률",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
