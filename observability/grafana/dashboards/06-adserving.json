    {
      "type": "timeseries",
      "title": "서빙 로그 유실률 (분당)",
      "description": "버린 카드와 쓰기에 실패한 카드를 내려준 카드 수로 나눴다. 다른 패널과 같은 짧은 구간으로 계산한다. 경보 AdservingServeLogLossHigh 는 10분 구간으로 보므로 이 선과 값이 다를 수 있다. 목표 0.1% 를 선으로 그렸다.",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
