// 앱의 스팬을 받아 테일 샘플링 뒤 모니터링 서버의 Tempo 로 보낸다(lunch-catch/lc-infra#72).
// 추적을 켠 환경(부하 시험 환경)에서만 config.alloy 뒤에 붙는다. compute 모듈의 tracing_enabled 가 정한다.

otelcol.receiver.otlp "app" {
	http {
		endpoint = "0.0.0.0:4318"
	}
	output {
		traces = [otelcol.processor.tail_sampling.app.input]
	}
}

// 기준은 lc-backend 의 qa-observability-guideline.md 3장이다.
// 요청 하나의 스팬이 모두 모일 때까지 기다린 뒤 정책 가운데 하나라도 맞으면 남긴다.
otelcol.processor.tail_sampling "app" {
	decision_wait = "10s"
	// 판정 뒤 늦게 온 스팬도 그 트레이스의 결정을 따른다. 몇 분씩 걸리는 cron 은 루트 스팬이 작업이 끝날 때 와서
	// 판정 대기를 넘긴다. 남기기로 한 트레이스의 루트를 버리지 않으려는 것이다(lunch-catch/lc-infra#143)
	decision_cache = {
		sampled_cache_size = 100000,
	}
	policy {
		name = "errors"
		type = "status_code"
		status_code {
			status_codes = ["ERROR"]
		}
	}
	// 피드 p99 목표(300ms)를 넘은 HTTP 요청은 모두 남긴다. http.route 가 있는 트레이스만 요청이다.
	// @Scheduled 작업은 오래 걸리는 것이 정상인 것이 많고 기준 초과를 지표로 판정해 이 규칙에서 뺀다(lunch-catch/lc-infra#104).
	// 작업의 판정 기준은 lc-backend#1128 이 갖는다.
	policy {
		name = "slow-requests"
		type = "and"
		and {
			and_sub_policy {
				name = "request"
				type = "string_attribute"
				string_attribute {
					key                    = "http.route"
					values                 = [".+"]
					enabled_regex_matching = true
				}
			}
			and_sub_policy {
				name = "over-300ms"
				type = "latency"
				latency {
					threshold_ms = 300
				}
			}
		}
	}
	// 핵심 거래 경로는 실패하면 돈이나 데이터를 잃는 요청이다(lc-backend 의 qa-reliability-guideline.md SLO 등급).
	// 노출과 정산의 결제와 환불이 여기에 든다. 피드는 조회라 일반 요청과 같이 1% 만 남긴다(lunch-catch/lc-infra#96).
	// 경로 목록은 lc-backend 의 docs/observability/트레이싱과_프로파일링_설계.md 4장이 갖는다.
	policy {
		name = "core-transactions"
		type = "and"
		and {
			and_sub_policy {
				name = "route"
				type = "string_attribute"
				string_attribute {
					key    = "http.route"
					values = [
						"/v1/admin/payments/{paymentId}:recheck",
						"/v1/admin/point-adjustments",
						"/v1/admin/refund-requests/{refundRequestId}:approve",
						"/v1/admin/refund-requests/{refundRequestId}:reject",
						"/v1/admin/settlement-mismatches/{mismatchId}:closeWithoutAdjustment",
						"/v1/impressions",
						"/v1/owner/payments",
						"/v1/owner/payments/{paymentId}:confirm",
						"/v1/owner/refund-requests",
					]
				}
			}
			and_sub_policy {
				name = "ten-percent"
				type = "probabilistic"
				probabilistic {
					sampling_percentage = 10
				}
			}
		}
	}
	/*
	 * 배치 서버의 트레이스다(lc-backend#1199). 서비스 이름은 run.sh switch --tracing 이 배치 서버에만 준다.
	 * cron 은 드물고 마감을 넘긴 실행을 빠짐없이 보려고 모두 남긴다. 루트 스팬이 판정 대기 안에 오지 않아도 남도록
	 * "잦은 작업의 루트가 보이지 않으면" 으로 고른다. 헬스체크와 지표 수집 같은 HTTP 요청은 뺀다.
	 * 배치가 뜰 때 Flyway 와 MySQL 드라이버가 main 스레드에서 내는 쿼리도 루트가 없어 뺀다(#147). 작업은 scheduling 스레드에서 돈다.
	 * 잦은 작업은 1초마다 도는 폴링이라 정상 실행은 남기지 않는다. 이름은 루트 스팬의 code.function 이다
	 * (OTel 에이전트의 spring-scheduling 계측). 잦은 작업이 늘면 아래 두 목록에 같이 더한다.
	 */
	policy {
		name = "batch-cron"
		type = "and"
		and {
			and_sub_policy {
				name = "batch"
				type = "string_attribute"
				string_attribute {
					key    = "service.name"
					values = ["lunchcatch-batch"]
				}
			}
			and_sub_policy {
				name = "not-frequent-job"
				type = "string_attribute"
				string_attribute {
					key          = "code.function"
					values       = ["dispatchPending", "recheckUnknownPayments", "reserveCharged", "sendHeartbeat", "takeOverStale"]
					invert_match = true
				}
			}
			and_sub_policy {
				name = "not-startup"
				type = "string_attribute"
				string_attribute {
					key          = "thread.name"
					values       = ["main"]
					invert_match = true
				}
			}
			and_sub_policy {
				name = "not-http"
				type = "string_attribute"
				string_attribute {
					key                    = "http.route"
					values                 = [".+"]
					enabled_regex_matching = true
					invert_match           = true
				}
			}
		}
	}
	/*
	 * 잦은 작업은 한 번이 1초를 넘은 실행만 남긴다. 1초는 릴레이의 주기라 넘으면 다음 실행이 밀리기 시작한다.
	 * 오류는 위 errors 가, 1% 는 아래 the-rest 가 남긴다.
	 */
	policy {
		name = "batch-frequent-slow"
		type = "and"
		and {
			and_sub_policy {
				name = "frequent-job"
				type = "string_attribute"
				string_attribute {
					key    = "code.function"
					values = ["dispatchPending", "recheckUnknownPayments", "reserveCharged", "sendHeartbeat", "takeOverStale"]
				}
			}
			and_sub_policy {
				name = "over-1s"
				type = "latency"
				latency {
					threshold_ms = 1000
				}
			}
		}
	}
	policy {
		name = "the-rest"
		type = "probabilistic"
		probabilistic {
			sampling_percentage = 1
		}
	}
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

// 앱 서버에서는 LOKI_ENDPOINT 가 모니터링 서버를 가리킨다. 로컬 구성은 TEMPO_ENDPOINT 로 tempo 컨테이너를 준다
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = coalesce(sys.env("TEMPO_ENDPOINT"), sys.env("LOKI_ENDPOINT")) + ":4317"
		tls {
			insecure = true
		}
	}
}
