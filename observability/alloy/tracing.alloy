// 앱의 스팬을 받아 테일 샘플링 뒤 모니터링 서버의 Tempo 로 보낸다(lunch-catch/lc-infra#72).
// 추적을 켠 환경(부하 시험 환경과 운영)에서만 config.alloy 뒤에 붙는다. compute 모듈의 tracing_enabled 가 정한다.

otelcol.receiver.otlp "app" {
	http {
		endpoint = "0.0.0.0:4318"
	}
	output {
		traces = [otelcol.processor.tail_sampling.app.input]
	}
}

// 기준은 lc-backend 의 qa-observability-guideline.md 3장이다.
// 요청 하나의 스팬이 모두 모일 때까지 기다린 뒤 정책 가운데 하나라도 맞으면 남긴다.
otelcol.processor.tail_sampling "app" {
	decision_wait = "10s"
	// 판정 뒤 늦게 온 스팬도 그 트레이스의 결정을 따른다. 몇 분씩 걸리는 cron 은 루트 스팬이 작업이 끝날 때 와서
	// 판정 대기를 넘긴다. 남기기로 한 트레이스의 루트를 버리지 않으려는 것이다(lunch-catch/lc-infra#143)
	decision_cache = {
		sampled_cache_size = 100000,
	}
	policy {
		name = "errors"
		type = "status_code"
		status_code {
			status_codes = ["ERROR"]
		}
	}
	/*
	 * 앞단(에이전트)이 앱 서버는 요청의 10% 만, 배치 서버는 모두 넘긴다(lc-infra #195). 여기서 넘어온 것 가운데
	 * 오류, 기준을 넘은 HTTP 요청, 백그라운드 작업은 모두 남기고 나머지는 10% 만 남겨, 최종으로 앞의 셋은 10%, 나머지는 1% 가 된다.
	 * 배치 서버의 cron 은 앞단에서 줄이지 않아 모두 남는다.
	 */
	/*
	 * HTTP 요청의 기준은 API 마다 다르다. 원본은 lc-backend 의 application.yml 의 lunchcatch.observability.targets(api, api-default)다.
	 * 그 값을 바꾸면 여기도 같은 PR 에서 고친다. 같은 경로에 메서드마다 기준이 달라(GET /v1/coupons 는 기본 500ms, POST 는 1000ms)
	 * 메서드와 경로를 함께 보는 OTTL 조건으로 고른다. latency 는 트레이스 전체의 시간이다.
	 */
	policy {
		name = "slow-feed"
		type = "and"
		and {
			and_sub_policy {
				name = "route"
				type = "ottl_condition"
				ottl_condition {
					error_mode = "ignore"
					span       = ["attributes[\"http.request.method\"] == \"GET\" and attributes[\"http.route\"] == \"/v1/feed\""]
				}
			}
			and_sub_policy {
				name = "over-300ms"
				type = "latency"
				latency {
					threshold_ms = 300
				}
			}
		}
	}
	policy {
		name = "slow-wishlist"
		type = "and"
		and {
			and_sub_policy {
				name = "route"
				type = "ottl_condition"
				ottl_condition {
					error_mode = "ignore"
					span       = ["attributes[\"http.request.method\"] == \"GET\" and attributes[\"http.route\"] == \"/v1/wishlist\""]
				}
			}
			and_sub_policy {
				name = "over-300ms"
				type = "latency"
				latency {
					threshold_ms = 300
				}
			}
		}
	}
	policy {
		name = "slow-coupon-issue"
		type = "and"
		and {
			and_sub_policy {
				name = "route"
				type = "ottl_condition"
				ottl_condition {
					error_mode = "ignore"
					span       = ["attributes[\"http.request.method\"] == \"POST\" and attributes[\"http.route\"] == \"/v1/coupons\""]
				}
			}
			and_sub_policy {
				name = "over-1000ms"
				type = "latency"
				latency {
					threshold_ms = 1000
				}
			}
		}
	}
	// 그 밖의 HTTP 요청은 기본 기준(500ms)으로 고른다. 기본보다 긴 기준을 가진 POST /v1/coupons 는 위 정책이 맡아 뺀다
	policy {
		name = "slow-requests"
		type = "and"
		and {
			and_sub_policy {
				name = "request"
				type = "ottl_condition"
				ottl_condition {
					error_mode = "ignore"
					span       = ["attributes[\"http.route\"] != nil and not (attributes[\"http.request.method\"] == \"POST\" and attributes[\"http.route\"] == \"/v1/coupons\")"]
				}
			}
			and_sub_policy {
				name = "over-500ms"
				type = "latency"
				latency {
					threshold_ms = 500
				}
			}
		}
	}
	/*
	 * 앱 서버의 백그라운드 작업(노출 저장, 서빙 로그 같은 워커)은 모두 남긴다. HTTP 요청이 아니고 기동 때의 main 스레드도 아닌 트레이스다.
	 * 워커의 기준은 대기열에서 기다린 시간이라 트레이스의 길이로 가를 수 없다. 앞단이 10% 로 줄여 양이 작다.
	 * 개발 서버는 한 프로세스가 API 와 cron 을 함께 돌려 cron 도 여기서 남는다.
	 */
	policy {
		name = "app-background"
		type = "and"
		and {
			and_sub_policy {
				name = "app"
				type = "string_attribute"
				string_attribute {
					key    = "service.name"
					values = ["lunchcatch"]
				}
			}
			and_sub_policy {
				name = "not-startup"
				type = "string_attribute"
				string_attribute {
					key          = "thread.name"
					values       = ["main"]
					invert_match = true
				}
			}
			and_sub_policy {
				name = "not-http"
				type = "string_attribute"
				string_attribute {
					key                    = "http.route"
					values                 = [".+"]
					enabled_regex_matching = true
					invert_match           = true
				}
			}
		}
	}
	/*
	 * 배치 서버의 트레이스다(lc-backend#1199). 서비스 이름은 run.sh switch --tracing 이 배치 서버에만 준다.
	 * cron 은 드물고 마감을 넘긴 실행을 빠짐없이 보려고 모두 남긴다. 루트 스팬이 판정 대기 안에 오지 않아도 남도록
	 * "잦은 작업의 루트가 보이지 않으면" 으로 고른다. 헬스체크와 지표 수집 같은 HTTP 요청은 뺀다.
	 * 배치가 뜰 때 Flyway 와 MySQL 드라이버가 main 스레드에서 내는 쿼리도 루트가 없어 뺀다(#147). 작업은 scheduling 스레드에서 돈다.
	 * 잦은 작업은 1초마다 도는 폴링이라 모두 남기면 저장량 대부분을 차지해 아래 the-rest 가 10% 만 남긴다(lc-infra #195).
	 * 이름은 루트 스팬의 code.function 이다(OTel 에이전트의 spring-scheduling 계측). 잦은 작업이 늘면 아래 목록에 더한다.
	 */
	policy {
		name = "batch-cron"
		type = "and"
		and {
			and_sub_policy {
				name = "batch"
				type = "string_attribute"
				string_attribute {
					key    = "service.name"
					values = ["lunchcatch-batch"]
				}
			}
			and_sub_policy {
				name = "not-frequent-job"
				type = "string_attribute"
				string_attribute {
					key          = "code.function"
					values       = ["dispatchPending", "recheckUnknownPayments", "reserveCharged", "sendHeartbeat", "takeOverStale"]
					invert_match = true
				}
			}
			and_sub_policy {
				name = "not-startup"
				type = "string_attribute"
				string_attribute {
					key          = "thread.name"
					values       = ["main"]
					invert_match = true
				}
			}
			and_sub_policy {
				name = "not-http"
				type = "string_attribute"
				string_attribute {
					key                    = "http.route"
					values                 = [".+"]
					enabled_regex_matching = true
					invert_match           = true
				}
			}
		}
	}
	// 나머지는 10% 만 남긴다. 앱 서버는 앞단 10% 를 지나와 최종 1%, 배치 서버의 잦은 작업은 앞단이 모두 넘겨 최종 10% 다
	policy {
		name = "the-rest"
		type = "probabilistic"
		probabilistic {
			sampling_percentage = 10
		}
	}
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

// 앱 서버에서는 LOKI_ENDPOINT 가 모니터링 서버를 가리킨다. 로컬 구성은 TEMPO_ENDPOINT 로 tempo 컨테이너를 준다
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = coalesce(sys.env("TEMPO_ENDPOINT"), sys.env("LOKI_ENDPOINT")) + ":4317"
		tls {
			insecure = true
		}
	}
}
