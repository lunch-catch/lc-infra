[Unit]
Description=${project} (${profiles})
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/${project}
EnvironmentFile=/opt/${project}/.env
ExecStart=/usr/bin/docker compose up -d --pull always
# 지난 이미지를 치운다. 배치 서버는 교체되지 않고 배포마다 새 SHA 이미지를 받아 쌓인다. 실패해도 기동은 막지 않는다(-)
ExecStartPost=-/usr/bin/docker image prune -af
ExecStop=/usr/bin/docker compose down
# 종료 타임아웃 계층의 가장 바깥이다. compose 45초보다 길어야 한다.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
